// IR golden: loops, break / continue, match, defer order, recursion,
// fn values.
module main
import os
import out

enum Color: u8 {
    Red
    Green = 5
    Blue
}

fn p(o: *mut out.Out, name: []u8, v: i64) {
    (*o).lit(name)
    (*o).lit(b" ")
    (*o).dec(v)
    (*o).nl()
}

fn fib(n: i32): i64 {
    if n < 2 {
        return cast(i64, n)
    }
    return fib(n - 1) + fib(n - 2)
}

fn ack(m: i64, n: i64): i64 {
    if m == 0 {
        return n + 1
    }
    if n == 0 {
        return ack(m - 1, 1)
    }
    return ack(m - 1, ack(m, n - 1))
}

fn loops(o: *mut out.Out) {
    let mut s = 0
    for i in 0..<100 {
        if i % 3 == 0 {
            continue
        }
        if i > 50 {
            break
        }
        s += i
    }
    p(o, b"for", cast(i64, s))
    let mut n = 0
    let mut k = 27
    while k != 1 {
        if k % 2 == 0 {
            k = k / 2
        } else {
            k = 3 * k + 1
        }
        n += 1
    }
    p(o, b"collatz", cast(i64, n))
    let mut t = 0
    for i in 0..<5 {
        for j in 0..<5 {
            if j > i {
                break
            }
            t += j
        }
    }
    p(o, b"nested", cast(i64, t))
    let mut u = 0
    for i := 0; i < 10; i += 2 {
        if i == 4 {
            continue
        }
        u += i
    }
    p(o, b"cfor", cast(i64, u))
}

fn classify(x: i32): i32 {
    match x {
        0 {
            return 100
        }
        1, 2, 3 {
            return 200
        }
        else {
            return 300
        }
    }
}

fn color_name(c: Color): []u8 {
    let n = match c {
        Color.Red { b"red" }
        Color.Green { b"green" }
        Color.Blue { b"blue" }
    }
    return n
}

fn defers(o: *mut out.Out, early: bool): i32 {
    defer (*o).lit(b"d1 ")
    {
        defer (*o).lit(b"inner ")
        (*o).lit(b"body ")
    }
    for i in 0..<3 {
        defer (*o).lit(b"loop ")
        if i == 1 {
            continue
        }
        if i == 2 {
            break
        }
    }
    defer (*o).lit(b"d2 ")
    if early {
        return 1
    }
    (*o).lit(b"end ")
    return 2
}

fn twice(f: fn(i32): i32, x: i32): i32 {
    return f(f(x))
}

fn inc(x: i32): i32 {
    return x + 1
}

fn sq(x: i32): i32 {
    return x * x
}

fn main() {
    let mut o = out.Out.stdout()
    p(&o, b"fib", fib(20))
    p(&o, b"ack", ack(2, 3))
    loops(&o)
    p(&o, b"classify", cast(i64, classify(0) + classify(2) + classify(9)))
    o.lit(color_name(Color.Green))
    o.lit(b" ")
    o.dec(cast(i64, cast(u8, Color.Blue)))
    o.nl()
    let r1 = defers(&o, true)
    o.nl()
    let r2 = defers(&o, false)
    o.nl()
    p(&o, b"defers", cast(i64, r1 * 10 + r2))
    let mut f = inc
    p(&o, b"twice inc", cast(i64, twice(f, 5)))
    f = sq
    p(&o, b"twice sq", cast(i64, twice(f, 3)))
    let b = 3 > 2 || fib(40) > 0
    if b && !(1 > 2 && fib(40) > 0) {
        o.lit(b"short-circuit")
        o.nl()
    }
    o.flush_quiet()
    os.exit(0)
}
