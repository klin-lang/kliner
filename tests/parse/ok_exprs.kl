    }
    let pk = pick a > b { a } { b }
    let mc = p.q.r(1).s[2].t()
    let fc = geo.dist(a, b)
    let nest = f(g(h(1)), [2, 3], Point{x: 4})
    if a == (Point{x: 1}).x {
    }
    if pt.x > 0 {
    }
    // `*` binds only on one line: the next line is a new statement
    let m = a
    *ptr = 3
    // a call needs `(` on the same line
    let k = f
    (b).go()
    return error(5)
}
