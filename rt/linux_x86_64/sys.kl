// module sys — Kliner, Linux x86-64 (stage2+). NOT valid Klin: the
// body-less `pub fn call6` is an intrinsic that only Kliner accepts in module
// `sys` (docs/02-core-subset.md C6). Klin never compiles this file;
// scripts/test.sh does not build it. Same API as rt/bootstrap/sys.kl.
module sys

// Raw syscall (`syscall`: rax, rdi rsi rdx r10 r8 r9; clobbers rcx r11).
pub fn call6(nr: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64): i64

// Plain Klin (D17), same as rt/bootstrap/sys.kl.
pub fn addr_u8(b: []u8): i64 { return cast(i64, &b[0]) }

pub const NR_READ: i64 = 0
pub const NR_WRITE: i64 = 1
pub const NR_CLOSE: i64 = 3
pub const NR_FSTAT: i64 = 5
pub const NR_LSEEK: i64 = 8
pub const NR_MMAP: i64 = 9
pub const NR_MUNMAP: i64 = 11
pub const NR_GETCWD: i64 = 79
pub const NR_GETDENTS64: i64 = 217
pub const NR_EXIT_GROUP: i64 = 231
pub const NR_OPENAT: i64 = 257
pub const NR_NEWFSTATAT: i64 = 262
