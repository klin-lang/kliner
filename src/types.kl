// module types — the checker's types, interned (stage 4). A type is an
// index into `Types.k`; equal types have equal indices, so `==` on two
// ids is Klin's structural `==` on KlinType (lib/type.dart). Struct and
// enum types name their declaration by an index into the checker's
// tables; an enum's equality ignores its base type, as in Klin.
module types
import arena

pub enum Tk: u8 {
    Prim // a = P
    Void
    Struct // a = struct index
    Enum // a = enum index
    Ptr // a = pointee, b = 1 if `*mut`
    Array // a = element, n = length
    Slice // a = element
    Fn // a = return type, b = index of the parameter list in `pl`
    Result // a = ok type
    UInt // untyped integer literal
    UEmpty // `[]` without a type
    BareErr // `error(code)` without a `!T` context
    Str // `str`: a C string (D22)
}

pub enum P: u8 {
    I8
    I16
    I32
    I64
    U8
    U16
    U32
    U64
    F32
    F64
    Bool
    Usize
    Isize
}

// Fixed ids: the primitives in P order, then these.
pub const I32: i32 = 2
pub const I64: i32 = 3
pub const U8: i32 = 4
pub const BOOL: i32 = 10
pub const VOID: i32 = 13
pub const UINT: i32 = 14
pub const UEMPTY: i32 = 15
pub const BARE: i32 = 16
pub const STR: i32 = 17

pub struct Ty {
    kind: Tk
    a: i32
    b: i32
    n: i64
}

pub struct Types {
    k: []Ty
    n: i32
    pl: []i32 // parameter lists: count, then the items
    npl: i32
    idx: []i32 // hash index into k, -1 empty
}

fn alloc_ty(a: *mut arena.Arena, n: i32): ![]Ty {
    let two: [2]Ty
    let size = cast(i64, &two[1]) - cast(i64, &two[0])
    let p = cast(*mut [arena.MAX_LEN]Ty, arena.alloc_addr(a, size * cast(i64, n))!)
    return (*p)[:n]
}

pub fn Types.new(a: *mut arena.Arena): !Types {
    let mut t: Types
    t.k = alloc_ty(a, 256)!
    t.pl = arena.alloc_i32(a, 256)!
    t.idx = arena.alloc_i32(a, 512)!
    for i in 0..<t.idx.len {
        t.idx[i] = -1
    }
    let mut ok = 0
    for p in 0..<13 {
        ok = intern(&t, a, Tk.Prim, p, 0, 0)!
    }
    ok = intern(&t, a, Tk.Void, 0, 0, 0)!
    ok = intern(&t, a, Tk.UInt, 0, 0, 0)!
    ok = intern(&t, a, Tk.UEmpty, 0, 0, 0)!
    ok = intern(&t, a, Tk.BareErr, 0, 0, 0)!
    ok = intern(&t, a, Tk.Str, 0, 0, 0)!
    return t
}

fn list_eq(t: *mut Types, x: i32, y: i32): bool {
    if x == y {
        return true
    }
    let n = (*t).pl[x]
    if (*t).pl[y] != n {
        return false
    }
    for i in 1..<n + 1 {
        if (*t).pl[x + i] != (*t).pl[y + i] {
            return false
        }
    }
    return true
}

fn hash(t: *mut Types, kind: Tk, x: i32, y: i32, n: i64): u64 {
    let mut h: u64 = 14695981039346656037
    h = (h ^ cast(u64, kind)) * 1099511628211
    h = (h ^ cast(u64, cast(u32, x))) * 1099511628211
    if kind == Tk.Fn {
        for i in 0..<(*t).pl[y] + 1 {
            h = (h ^ cast(u64, cast(u32, (*t).pl[y + i]))) * 1099511628211
        }
    } else {
        h = (h ^ cast(u64, cast(u32, y))) * 1099511628211
    }
    h = (h ^ cast(u64, n)) * 1099511628211
    return h
}

fn same(t: *mut Types, i: i32, kind: Tk, x: i32, y: i32, n: i64): bool {
    let e = (*t).k[i]
    if e.kind != kind || e.a != x || e.n != n {
        return false
    }
    if kind == Tk.Fn {
        return list_eq(t, e.b, y)
    }
    return e.b == y
}

fn find(t: *mut Types, kind: Tk, x: i32, y: i32, n: i64): i32 {
    let mask = (*t).idx.len - 1
    let mut s = cast(i32, hash(t, kind, x, y, n) & cast(u64, mask))
    while (*t).idx[s] >= 0 {
        if same(t, (*t).idx[s], kind, x, y, n) {
            return s
        }
        s = (s + 1) & mask
    }
    return s
}

fn rehash(t: *mut Types, a: *mut arena.Arena): !i32 {
    (*t).idx = arena.alloc_i32(a, (*t).idx.len * 2)!
    for i in 0..<(*t).idx.len {
        (*t).idx[i] = -1
    }
    for i in 0..<(*t).n {
        let e = (*t).k[i]
        (*t).idx[find(t, e.kind, e.a, e.b, e.n)] = i
    }
    return 0
}

// The id of a type; adds it when new. For Tk.Fn, y is a list from
// `params` (it is kept only when the type is new).
pub fn intern(t: *mut Types, a: *mut arena.Arena, kind: Tk, x: i32, y: i32, n: i64): !i32 {
    let s = find(t, kind, x, y, n)
    if (*t).idx[s] >= 0 {
        return (*t).idx[s]
    }
    if (*t).n == (*t).k.len {
        let mut bigger = alloc_ty(a, (*t).n * 2)!
        for i in 0..<(*t).n {
            bigger[i] = (*t).k[i]
        }
        (*t).k = bigger
    }
    let i = (*t).n
    (*t).k[i].kind = kind
    (*t).k[i].a = x
    (*t).k[i].b = y
    (*t).k[i].n = n
    (*t).n += 1
    (*t).idx[s] = i
    if (*t).n * 2 > (*t).idx.len {
        let ok = rehash(t, a)!
    }
    return i
}

// A parameter list for Tk.Fn from ps[0:n].
pub fn params(t: *mut Types, a: *mut arena.Arena, ps: []i32): !i32 {
    if (*t).npl + ps.len + 1 > (*t).pl.len {
        let mut bigger = arena.alloc_i32(a, (*t).pl.len * 2 + ps.len + 1)!
        for i in 0..<(*t).npl {
            bigger[i] = (*t).pl[i]
        }
        (*t).pl = bigger
    }
    let l = (*t).npl
    (*t).pl[l] = ps.len
    for i in 0..<ps.len {
        (*t).pl[l + 1 + i] = ps[i]
    }
    (*t).npl += ps.len + 1
    return l
}

pub fn kind(t: *mut Types, id: i32): Tk {
    return (*t).k[id].kind
}

pub fn ty(t: *mut Types, id: i32): Ty {
    return (*t).k[id]
}

pub fn ptr(t: *mut Types, a: *mut arena.Arena, to: i32, is_mut: bool): !i32 {
    let mut m = 0
    if is_mut {
        m = 1
    }
    return intern(t, a, Tk.Ptr, to, m, 0)
}

pub fn slice(t: *mut Types, a: *mut arena.Arena, elem: i32): !i32 {
    return intern(t, a, Tk.Slice, elem, 0, 0)
}

pub fn array(t: *mut Types, a: *mut arena.Arena, elem: i32, len: i64): !i32 {
    return intern(t, a, Tk.Array, elem, 0, len)
}

pub fn result(t: *mut Types, a: *mut arena.Arena, ok: i32): !i32 {
    return intern(t, a, Tk.Result, ok, 0, 0)
}

// Fn type: parameter j of the list is pl[l + 1 + j].
pub fn nparams(t: *mut Types, id: i32): i32 {
    return (*t).pl[(*t).k[id].b]
}

pub fn param(t: *mut Types, id: i32, j: i32): i32 {
    return (*t).pl[(*t).k[id].b + 1 + j]
}

// ---- primitive kinds (PrimKind in lib/type.dart) ----

pub fn is_prim(t: *mut Types, id: i32): bool {
    return (*t).k[id].kind == Tk.Prim
}

pub fn is_int(t: *mut Types, id: i32): bool {
    if (*t).k[id].kind != Tk.Prim {
        return false
    }
    let p = (*t).k[id].a
    return p != 8 && p != 9 && p != 10
}

pub fn is_float(t: *mut Types, id: i32): bool {
    return (*t).k[id].kind == Tk.Prim && ((*t).k[id].a == 8 || (*t).k[id].a == 9)
}

pub fn is_unsigned(t: *mut Types, id: i32): bool {
    let p = (*t).k[id].a
    return (*t).k[id].kind == Tk.Prim && ((p >= 4 && p <= 7) || p == 11)
}

// Klin name of primitive p (`bool` for P.Bool).
pub fn prim_name(p: i32): []u8 {
    match p {
        0 { return b"i8" }
        1 { return b"i16" }
        2 { return b"i32" }
        3 { return b"i64" }
        4 { return b"u8" }
        5 { return b"u16" }
        6 { return b"u32" }
        7 { return b"u64" }
        8 { return b"f32" }
        9 { return b"f64" }
        10 { return b"bool" }
        11 { return b"usize" }
        else { return b"isize" }
    }
}

// PrimKind.tryParse: id of a primitive type name, -1 if none.
pub fn prim_of(s: []u8): i32 {
    for p in 0..<13 {
        let n = prim_name(p)
        if eqs(s, n) {
            return p
        }
    }
    if eqs(s, b"int") {
        return 2
    }
    if eqs(s, b"float") {
        return 9
    }
    return -1
}

fn eqs(x: []u8, y: []u8): bool {
    if x.len != y.len {
        return false
    }
    for i in 0..<x.len {
        if x[i] != y[i] {
            return false
        }
    }
    return true
}

// Bit width of an integer primitive (usize/isize: 64).
pub fn width(p: i32): i32 {
    match p {
        0, 4 { return 8 }
        1, 5 { return 16 }
        2, 6 { return 32 }
        else { return 64 }
    }
}
