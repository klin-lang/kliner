// resolve.kl: types from type nodes (Klin's _resolveType), array
// lengths, integer constant evaluation and literal range checks.
module check
import arena
import ast
import load
import tab
import types

// Features of Klin that Kliner does not check yet.
fn unsupported(c: *mut Ck, tok: i32, what: []u8): i32 {
    return fail3(c, tok, b"", what, b" is not supported by Kliner yet")
}

// The token's text as Klin's parser spells it in a type string.
fn add_lexeme(c: *mut Ck, tok: i32) {
    madd(c, txt(c, tok))
}

// Klin's type string of a type node (the parser's typeName).
fn tystr(c: *mut Ck, n: i32) {
    let x = nd(c, n)
    match x.kind {
        ast.Nk.TName {
            madd(c, txt(c, x.tok))
            if x.a >= 0 {
                madd(c, b".")
                madd(c, txt(c, x.a))
            }
        }
        ast.Nk.TPtr {
            madd(c, b"*")
            if (x.b & 1) != 0 {
                madd(c, b"mut ")
            }
            if (x.b & 2) != 0 {
                madd(c, b"volatile ")
            }
            tystr(c, x.a)
        }
        ast.Nk.TSlice {
            madd(c, b"[]")
            tystr(c, x.a)
        }
        ast.Nk.TArray {
            madd(c, b"[")
            len_text(c, n)
            madd(c, b"]")
            tystr(c, x.b)
        }
        ast.Nk.TErr {
            madd(c, b"!")
            tystr(c, x.a)
        }
        else {
            madd(c, b"fn(")
            for j in 0..<cnt(c, x.extra) {
                if j > 0 {
                    madd(c, b",")
                }
                tystr(c, kid(c, x.extra, j))
            }
            madd(c, b"):")
            if x.a >= 0 {
                tystr(c, x.a)
            } else {
                madd(c, b"void")
            }
        }
    }
}

// The length text of a TArray node: its tokens, spaced as Klin's parser
// joins them.
fn len_text(c: *mut Ck, n: i32) {
    let x = nd(c, n)
    let mut prev = txt(c, x.c)
    for j in x.c..<x.extra {
        let lx = txt(c, j)
        if j > x.c && !tab.eq(lx, b".") && !tab.eq(prev, b".") {
            madd(c, b" ")
        }
        madd(c, lx)
        prev = lx
    }
}

// A qualifier: the current module by name, else an import alias.
fn resolve_qual(c: *mut Ck, qtok: i32, pos: i32): !i32 {
    let q = txt(c, qtok)
    if tab.eq(q, (*(*c).p).mods[(*c).cm]) {
        return (*c).cm
    }
    let m = tab.get(&(*(*c).p).aliases, q, (*c).cm)
    if m >= 0 {
        return m
    }
    return error(fail3(c, pos, b"module `", q, b"` is not imported"))
}

// The alias's module, or -1 (no error): Klin's _importAliases lookup or
// the current module's own name.
fn alias_mod(c: *mut Ck, q: []u8): i32 {
    let m = tab.get(&(*(*c).p).aliases, q, (*c).cm)
    if m >= 0 {
        return m
    }
    if tab.eq(q, (*(*c).p).mods[(*c).cm]) {
        return (*c).cm
    }
    return -1
}

fn is_pub(c: *mut Ck, r: load.Ref): bool {
    let f = load.file((*c).p, r.file)
    return ((*f).t.nodes[r.decl].b & 1) != 0
}

fn struct_ty(c: *mut Ck, s: i32): !i32 {
    return types.intern(&(*c).t, (*c).a, types.Tk.Struct, s, 0, 0)
}

fn enum_type(c: *mut Ck, e: i32): !i32 {
    return types.intern(&(*c).t, (*c).a, types.Tk.Enum, e, 0, 0)
}

fn zero_len_array(c: *mut Ck, id: i32): bool {
    let mut cur = id
    while kind(c, cur) == types.Tk.Array {
        if tyof(c, cur).n == 0 {
            return true
        }
        cur = elem(c, cur)
    }
    return false
}

// Klin's _resolveType: n is a type node of the current file; every error
// is at pos.
fn resolve(c: *mut Ck, n: i32, pos: i32): !i32 {
    let x = nd(c, n)
    match x.kind {
        ast.Nk.TErr {
            let mut ok = resolve(c, x.a, pos)!
            let k = kind(c, ok)
            if k == types.Tk.Void || k == types.Tk.Array || k == types.Tk.Result {
                let e = fail(c, pos, b"invalid result type `")
                tystr(c, n)
                madd(c, b"`")
                return error(e)
            }
            return mk_result(c, ok)
        }
        ast.Nk.TFn {
            let np = cnt(c, x.extra)
            let mut ps = arena_i32(c, np + 1)!
            for j in 0..<np {
                ps[j] = resolve(c, kid(c, x.extra, j), pos)!
            }
            let mut ret = types.VOID
            if x.a >= 0 {
                ret = resolve(c, x.a, pos)!
            }
            if kind(c, ret) == types.Tk.Result {
                return error(failt(c, pos, b"function type cannot return `", ret, b"`"))
            }
            if zero_len_array(c, ret) {
                return error(failt(c, pos, b"function cannot return a zero-length array `", ret, b"`"))
            }
            return fn_type(c, ps[:np], ret)
        }
        ast.Nk.TPtr {
            if (x.b & 2) != 0 {
                return error(unsupported(c, pos, b"`volatile`"))
            }
            let to = resolve(c, x.a, pos)!
            return mk_ptr(c, to, (x.b & 1) != 0)
        }
        ast.Nk.TSlice {
            let e = resolve(c, x.a, pos)!
            let mut ok = require_slice_elem(c, e, pos)!
            return mk_slice(c, e)
        }
        ast.Nk.TArray {
            let len = array_len(c, n, pos)!
            let e = resolve(c, x.b, pos)!
            return mk_array(c, e, len)
        }
        else {
        }
    }
    return resolve_tname(c, x.tok, x.a, pos)
}

// A type name `name` or `q.name` (qtok = x.tok, atok = name tok or -1).
fn resolve_tname(c: *mut Ck, ntok: i32, atok: i32, pos: i32): !i32 {
    let x = Tn{tok: ntok, a: atok}
    let name = txt(c, x.tok)
    if x.a < 0 {
        if tab.eq(name, b"void") {
            return types.VOID
        }
        if tab.eq(name, b"str") {
            return types.STR
        }
    }
    let mut m = (*c).cm
    let mut tname = name
    if x.a >= 0 {
        m = resolve_qual(c, x.tok, pos)!
        tname = txt(c, x.a)
    }
    let s = tab.get(&(*c).structs, tname, m)
    if s >= 0 {
        if m != (*c).cm && !is_pub(c, (*(*c).p).structs.r[s]) {
            let e = fail(c, pos, b"struct `")
            shown_mod(c, x.tok, x.a, m)
            madd(c, tname)
            madd(c, b"` is private")
            return error(e)
        }
        return struct_ty(c, s)
    }
    let en = tab.get(&(*c).enums, tname, m)
    if en >= 0 {
        if m != (*c).cm && !is_pub(c, (*(*c).p).enums.r[en]) {
            let e = fail(c, pos, b"enum `")
            shown_mod(c, x.tok, x.a, m)
            madd(c, tname)
            madd(c, b"` is private")
            return error(e)
        }
        return enum_type(c, en)
    }
    if x.a >= 0 {
        let e = fail3(c, pos, b"unknown type `", name, b".")
        madd(c, tname)
        madd(c, b"`")
        return error(e)
    }
    let p = types.prim_of(name)
    if p < 0 {
        return error(fail3(c, pos, b"unknown type `", name, b"`"))
    }
    if p == 8 || p == 9 {
        return error(fail3(c, pos, b"`", name, b"` is not supported by Kliner yet"))
    }
    return p
}

struct Tn {
    tok: i32
    a: i32
}

// `qualifier.` as written, else the module's name, then a dot.
fn shown_mod(c: *mut Ck, qtok: i32, has_q: i32, m: i32) {
    if has_q >= 0 {
        madd(c, txt(c, qtok))
    } else {
        madd(c, (*(*c).p).mods[m])
    }
    madd(c, b".")
}

fn arena_i32(c: *mut Ck, n: i32): ![]i32 {
    return arena.alloc_i32((*c).a, n)
}

fn fn_type(c: *mut Ck, ps: []i32, ret: i32): !i32 {
    let pl = types.params(&(*c).t, (*c).a, ps)!
    return types.intern(&(*c).t, (*c).a, types.Tk.Fn, ret, pl, 0)
}

fn require_slice_elem(c: *mut Ck, e: i32, pos: i32): !i32 {
    let k = kind(c, e)
    if k == types.Tk.Prim || k == types.Tk.Struct || k == types.Tk.Enum || k == types.Tk.Str || k == types.Tk.Ptr || k == types.Tk.Fn {
        return 0
    }
    if k == types.Tk.Slice {
        return require_slice_elem(c, elem(c, e), pos)
    }
    if k == types.Tk.Array {
        require_slice_elem(c, elem(c, e), pos)!
        let mut inner = elem(c, e)
        while kind(c, inner) == types.Tk.Array {
            inner = elem(c, inner)
        }
        if kind(c, inner) == types.Tk.Struct {
            return error(fail(c, pos, b"slice element cannot be an array of structs"))
        }
        return 0
    }
    if k == types.Tk.Result {
        return error(fail(c, pos, b"slice element cannot be a result type"))
    }
    if k == types.Tk.Void {
        return error(fail(c, pos, b"slice element cannot be `void`"))
    }
    return error(failt(c, pos, b"slice element type `", e, b"` is not supported"))
}

// ---- array lengths ----

fn fail_len(c: *mut Ck, pos: i32, tn: i32, s1: []u8, s2: []u8): i32 {
    let e = fail(c, pos, s1)
    len_text(c, tn)
    madd(c, s2)
    return e
}

// Klin's _resolveArrayLength for the TArray node tn.
fn array_len(c: *mut Ck, tn: i32, pos: i32): !i64 {
    let ex = nd(c, tn).a
    let node = peel(c, ex)
    let x = nd(c, node)
    if x.kind == ast.Nk.Int {
        let lv = lit_value(c, x.tok)
        if !lv.ok {
            return error(fail_len(c, pos, tn, b"invalid array type `[", b"]`"))
        }
        return len_from_big(c, lv.v, tn, -1, -1, pos)
    }
    if x.kind == ast.Nk.Name {
        let k = len_const(c, -1, x.tok, pos)!
        return len_of_const(c, k, -1, x.tok, pos)
    }
    if x.kind == ast.Nk.Get && nk(c, x.a) == ast.Nk.Name {
        let q = nd(c, x.a).tok
        let k = len_const(c, q, x.tok, pos)!
        return len_of_const(c, k, q, x.tok, pos)
    }
    let mut found: i32 = -1
    let ty = len_expr_type(c, ex, tn, pos, &found) or {
        return error(repos(c, err, pos))
    }
    let mut lt = found
    if lt < 0 {
        lt = types.I32
    }
    let v = eval(c, ex, lt) or {
        if err == E_NOTCONST {
            return error(fail_len(c, pos, tn, b"array length `", b"` must be an integer constant expression"))
        }
        return error(repos(c, err, pos))
    }
    return len_from_big(c, v, tn, -1, -1, pos)
}

// shown: the length text of tn, or `q.name` / `name` (qtok, ntok).
fn add_shown(c: *mut Ck, tn: i32, qtok: i32, ntok: i32) {
    if tn >= 0 {
        len_text(c, tn)
        return
    }
    if qtok >= 0 {
        madd(c, txt(c, qtok))
        madd(c, b".")
    }
    madd(c, txt(c, ntok))
}

fn len_from_big(c: *mut Ck, v: Big, tn: i32, qtok: i32, ntok: i32, pos: i32): !i64 {
    if v.neg {
        let e = fail(c, pos, b"array length `")
        add_shown(c, tn, qtok, ntok)
        madd(c, b"` must be non-negative")
        return error(e)
    }
    if big_bitlen_gt63(v) {
        let e = fail(c, pos, b"array length `")
        add_shown(c, tn, qtok, ntok)
        madd(c, b"` is too large")
        return error(e)
    }
    return cast(i64, v.lo)
}

// Klin's _lookupArrayLengthConst.
fn len_const(c: *mut Ck, qtok: i32, ntok: i32, pos: i32): !i32 {
    let name = txt(c, ntok)
    if qtok < 0 {
        let k = tab.get(&(*c).consts, name, (*c).cm)
        if k < 0 {
            return error(fail3(c, pos, b"unknown constant `", name, b"`"))
        }
        return k
    }
    let m = resolve_qual(c, qtok, pos)!
    let k = tab.get(&(*c).consts, name, m)
    if k < 0 {
        let e = fail3(c, pos, b"unknown constant `", txt(c, qtok), b".")
        madd(c, name)
        madd(c, b"`")
        return error(e)
    }
    if m != (*c).cm && !is_pub(c, (*(*c).p).consts.r[k]) {
        let e = fail3(c, pos, b"constant `", txt(c, qtok), b".")
        madd(c, name)
        madd(c, b"` is private")
        return error(e)
    }
    return k
}

fn add_ty_or_unknown(c: *mut Ck, ty: i32) {
    if ty < 0 {
        madd(c, b"unknown")
    } else {
        addt(c, ty)
    }
}

fn len_of_const(c: *mut Ck, k: i32, qtok: i32, ntok: i32, pos: i32): !i64 {
    let ty = (*c).const_ty[k]
    if ty >= 0 && is_int(c, ty) && (*c).const_st[k] != 2 {
        bind_const(c, k)!
    }
    if (*c).const_st[k] != 2 || ty < 0 || !is_int(c, ty) {
        let e = fail(c, pos, b"array length `")
        add_shown(c, -1, qtok, ntok)
        madd(c, b"` must be an integer constant, got `")
        add_ty_or_unknown(c, ty)
        madd(c, b"`")
        return error(e)
    }
    return len_from_big(c, (*c).const_v[k], -1, qtok, ntok, pos)
}

// Klin's _arrayLengthExprType: the one integer type of the constants in
// the expression (found), or -1.
fn len_expr_type(c: *mut Ck, e: i32, tn: i32, pos: i32, found: *mut i32): !i32 {
    let node = peel(c, e)
    let x = nd(c, node)
    if x.kind == ast.Nk.Int {
        return 0
    }
    let mut k: i32 = -1
    if x.kind == ast.Nk.Name {
        k = len_const(c, -1, x.tok, pos)!
    } else if x.kind == ast.Nk.Get && nk(c, x.a) == ast.Nk.Name {
        k = len_const(c, nd(c, x.a).tok, x.tok, pos)!
    } else if x.kind == ast.Nk.Unary {
        return len_expr_type(c, x.a, tn, pos, found)
    } else if x.kind == ast.Nk.Binary {
        len_expr_type(c, x.a, tn, pos, found)!
        return len_expr_type(c, x.b, tn, pos, found)
    } else {
        return 0
    }
    let ty = (*c).const_ty[k]
    if ty < 0 || !is_int(c, ty) {
        let e2 = fail_len(c, pos, tn, b"array length `", b"` must be an integer constant, got `")
        add_ty_or_unknown(c, ty)
        madd(c, b"`")
        return error(e2)
    }
    if *found >= 0 && *found != ty {
        let e3 = failt(c, pos, b"type mismatch: `", *found, b"` and `")
        addt(c, ty)
        madd(c, b"`")
        return error(e3)
    }
    *found = ty
    return 0
}

// ---- integer constants ----

fn const_ref(c: *mut Ck, k: i32): load.Ref {
    return (*(*c).p).consts.r[k]
}

// Klin's _bindIntegerConst.
fn bind_const(c: *mut Ck, k: i32): !i32 {
    if (*c).const_st[k] == 2 {
        return 0
    }
    let r = const_ref(c, k)
    let scf = (*c).cf
    let scm = (*c).cm
    (*c).cf = r.file
    (*c).cm = decl_mod(c, r)
    let cn = nd(c, r.node)
    if (*c).const_st[k] == 1 {
        let e = fail3(c, cn.tok, b"constant `", txt(c, cn.a), b"` depends on itself")
        (*c).cf = scf
        (*c).cm = scm
        return error(e)
    }
    (*c).const_st[k] = 1
    let ty = (*c).const_ty[k]
    let v = eval(c, cn.c, ty) or {
        let mut e = err
        if err == E_NOTCONST {
            e = fail(c, nd(c, cn.c).tok, b"integer constant must be an integer constant expression")
        }
        (*c).cf = scf
        (*c).cm = scm
        return error(e)
    }
    (*c).const_v[k] = v
    (*c).const_st[k] = 2
    set_rt(c, cn.c, ty)
    (*c).cf = scf
    (*c).cm = scm
    return 0
}

// `integer literal `spelling` is out of range …` unless v fits p.
// spelling: pre + the token's text, or v itself when tok < 0.
fn reject_range(c: *mut Ck, v: Big, p: i32, pos: i32, pre: []u8, stok: i32): !i32 {
    if big_fits(v, p) {
        return 0
    }
    let e = fail(c, pos, b"integer literal `")
    if stok < 0 {
        mbig(c, v)
    } else {
        madd(c, pre)
        madd(c, txt(c, stok))
    }
    madd(c, b"` is out of range for `")
    madd(c, types.prim_name(p))
    madd(c, b"` (")
    mrange(c, p)
    madd(c, b")")
    return error(e)
}

fn grouped_lit(c: *mut Ck, n: i32): i32 {
    let x = peel(c, n)
    if nk(c, x) == ast.Nk.Int {
        return x
    }
    return -1
}

// Klin's _evalConstInt: p is an integer primitive.
fn eval(c: *mut Ck, e: i32, p: i32): !Big {
    let node = peel(c, e)
    let x = nd(c, node)
    if x.kind == ast.Nk.Int {
        let lv = lit_value(c, x.tok)
        if !lv.ok {
            return error(E_NOTCONST)
        }
        let mut ok = reject_range(c, lv.v, p, x.tok, b"", x.tok)!
        return lv.v
    }
    if x.kind == ast.Nk.Name {
        return named_const(c, -1, x.tok, p, x.tok)
    }
    if x.kind == ast.Nk.Get && nk(c, x.a) == ast.Nk.Name {
        return named_const(c, nd(c, x.a).tok, x.tok, p, x.tok)
    }
    if x.kind == ast.Nk.Unary {
        return eval_unary(c, node, p)
    }
    if x.kind == ast.Nk.Binary {
        return eval_binary(c, node, p)
    }
    return error(E_NOTCONST)
}

fn named_const(c: *mut Ck, qtok: i32, ntok: i32, p: i32, pos: i32): !Big {
    let name = txt(c, ntok)
    let mut k: i32 = -1
    if qtok < 0 {
        k = tab.get(&(*c).consts, name, (*c).cm)
        if k < 0 {
            return error(fail3(c, pos, b"unknown constant `", name, b"`"))
        }
    } else {
        let m = resolve_qual(c, qtok, pos)!
        k = tab.get(&(*c).consts, name, m)
        if k < 0 {
            let e = fail3(c, pos, b"unknown constant `", txt(c, qtok), b".")
            madd(c, name)
            madd(c, b"`")
            return error(e)
        }
        if m != (*c).cm && !is_pub(c, const_ref(c, k)) {
            let e = fail3(c, pos, b"constant `", txt(c, qtok), b".")
            madd(c, name)
            madd(c, b"` is private")
            return error(e)
        }
    }
    let actual = (*c).const_ty[k]
    if actual < 0 || !is_int(c, actual) {
        let e = fail3(c, pos, b"constant `", name, b"` has type `")
        add_ty_or_unknown(c, actual)
        madd(c, b"`, expected `")
        addt(c, p)
        madd(c, b"`")
        return error(e)
    }
    if actual != p {
        let e = failt(c, pos, b"type mismatch: expected `", p, b"`, got `")
        addt(c, actual)
        madd(c, b"`")
        return error(e)
    }
    bind_const(c, k)!
    return (*c).const_v[k]
}

fn eval_unary(c: *mut Ck, n: i32, p: i32): !Big {
    let x = nd(c, n)
    let o = txt(c, x.tok)
    if tab.eq(o, b"-") {
        let lit = grouped_lit(c, x.a)
        if lit >= 0 {
            let lt = nd(c, lit).tok
            let lv = lit_value(c, lt)
            if !lv.ok {
                return error(E_NOTCONST)
            }
            let v = big_neg(lv.v)
            let mut ok = reject_range(c, v, p, x.tok, b"-", lt)!
            set_rt(c, x.a, p)
            return v
        }
        let v = big_neg(eval(c, x.a, p)!)
        let mut ok = reject_range(c, v, p, x.tok, b"", -1)!
        return v
    }
    if tab.eq(o, b"~") {
        let lit = grouped_lit(c, x.a)
        if lit >= 0 {
            let lt = nd(c, lit).tok
            let lv = lit_value(c, lt)
            if !lv.ok {
                return error(E_NOTCONST)
            }
            let mut ok = reject_range(c, lv.v, p, lt, b"", lt)!
            let f = big_not(lv.v, p)
            reject_range(c, f, p, x.tok, b"~", lt)!
            set_rt(c, x.a, p)
            return f
        }
        let v = eval(c, x.a, p)!
        return big_not(v, p)
    }
    return error(E_NOTCONST)
}

fn eval_binary(c: *mut Ck, n: i32, p: i32): !Big {
    let x = nd(c, n)
    let o = txt(c, x.tok)
    if tab.eq(o, b"<<") || tab.eq(o, b">>") {
        let l = eval(c, x.a, p)!
        let r = eval(c, x.b, p)!
        if r.neg {
            return error(fail(c, x.tok, b"shift by a negative count"))
        }
        let w = bits_of(p)
        if r.hi != 0 || r.lo >= cast(u64, w) {
            let e = fail(c, x.tok, b"shift by `")
            mbig(c, r)
            madd(c, b"` is wider than `")
            madd(c, types.prim_name(p))
            madd(c, b"` (width ")
            mdec(c, cast(i64, w))
            madd(c, b")")
            return error(e)
        }
        let sh = cast(i32, r.lo)
        let mut v = big_u(0)
        if tab.eq(o, b"<<") {
            v = big_shl(l, sh)
        } else {
            v = big_shr(l, sh)
        }
        reject_range(c, v, p, x.tok, b"", -1)!
        return v
    }
    if tab.eq(o, b"/") || tab.eq(o, b"%") {
        let l = eval(c, x.a, p)!
        let r = eval(c, x.b, p)!
        if big_zero(r) {
            if tab.eq(o, b"/") {
                return error(fail(c, x.tok, b"division by zero"))
            }
            return error(fail(c, x.tok, b"remainder by zero"))
        }
        let mut v = big_rem(l, r)
        if tab.eq(o, b"/") {
            v = big_div(l, r)
        }
        reject_range(c, v, p, x.tok, b"", -1)!
        return v
    }
    let mut which: i32 = -1
    if tab.eq(o, b"+") {
        which = 0
    } else if tab.eq(o, b"-") {
        which = 1
    } else if tab.eq(o, b"*") {
        which = 2
    } else if tab.eq(o, b"&") {
        which = 3
    } else if tab.eq(o, b"|") {
        which = 4
    } else if tab.eq(o, b"^") {
        which = 5
    }
    if which < 0 {
        return error(E_NOTCONST)
    }
    let l = eval(c, x.a, p)!
    let r = eval(c, x.b, p)!
    let mut v = big_u(0)
    if which == 0 {
        v = big_add(l, r)
    } else if which == 1 {
        v = big_sub(l, r)
    } else if which == 2 {
        v = big_mul(l, r)
    } else {
        v = big_bits(l, r, which - 3)
    }
    reject_range(c, v, p, x.tok, b"", -1)!
    return v
}

// Klin's _checkCoercedIntLiteral.
fn check_coerced_lit(c: *mut Ck, e: i32, ty: i32): !i32 {
    let node = peel(c, e)
    let x = nd(c, node)
    let int_ty = is_int(c, ty)
    if x.kind == ast.Nk.Unary && tab.eq(txt(c, x.tok), b"~") && !int_ty {
        return error(failt(c, x.tok, b"operator `~` requires an integer type, got `", ty, b"`"))
    }
    if !int_ty {
        return 0
    }
    if x.kind == ast.Nk.Int {
        let lv = lit_value(c, x.tok)
        if !lv.ok {
            return 0
        }
        return reject_range(c, lv.v, ty, x.tok, b"", x.tok)
    }
    if x.kind != ast.Nk.Unary {
        return 0
    }
    let o = txt(c, x.tok)
    if !tab.eq(o, b"-") && !tab.eq(o, b"~") {
        return 0
    }
    let lit = grouped_lit(c, x.a)
    if lit < 0 {
        return 0
    }
    let lt = nd(c, lit).tok
    let lv = lit_value(c, lt)
    if !lv.ok {
        return 0
    }
    if tab.eq(o, b"-") {
        return reject_range(c, big_neg(lv.v), ty, x.tok, b"-", lt)
    }
    if !big_fits(lv.v, ty) {
        return reject_range(c, lv.v, ty, lt, b"", lt)
    }
    return reject_range(c, big_not(lv.v, ty), ty, x.tok, b"~", lt)
}

// ---- enums ----

// The first variant before n whose value equals x, or -1 (values were
// checked by the caller's earlier iterations).
fn enum_dup(c: *mut Ck, en: ast.Node, n: i32, x: Big): i32 {
    let mut next = big_u(0)
    for j in 0..<n {
        let v = nd(c, kid(c, en.extra, j))
        if v.a >= 0 && nk(c, v.a) == ast.Nk.Int {
            next = lit_value(c, nd(c, v.a).tok).v
        }
        if next.neg == x.neg && next.hi == x.hi && next.lo == x.lo {
            return j
        }
        next = big_add(next, big_u(1))
    }
    return -1
}

// Klin's _enumDiscriminants for enum e. mode 0: the range check of the
// registration; mode 1: Klin's _checkEnumIndex fit check for `[len]`.
fn enum_values(c: *mut Ck, e: i32, mode: i32, len: i64, pos: i32): !i32 {
    let r = (*(*c).p).enums.r[e]
    let scf = (*c).cf
    (*c).cf = r.file
    let en = nd(c, r.node)
    let base = (*c).enum_base[e]
    let mut next = big_u(0)
    for i in 0..<cnt(c, en.extra) {
        let v = nd(c, kid(c, en.extra, i))
        if v.a >= 0 && nk(c, v.a) == ast.Nk.Int {
            let lv = lit_value(c, nd(c, v.a).tok)
            if !lv.ok {
                let e1 = fail(c, nd(c, v.a).tok, b"enum value must be an integer literal")
                (*c).cf = scf
                return error(e1)
            }
            next = lv.v
        } else if mode == 0 && !big_fits(next, base) {
            let e2 = fail3(c, v.tok, b"enum variant `", txt(c, v.tok), b"` value ")
            mbig(c, next)
            madd(c, b" is out of range for `")
            madd(c, types.prim_name(base))
            madd(c, b"` (")
            mrange(c, base)
            madd(c, b")")
            (*c).cf = scf
            return error(e2)
        }
        if mode == 0 {
            // D25 (Klin f9f5471): no two variants share a value.
            let pj = enum_dup(c, en, i, next)
            if pj >= 0 {
                let e4 = fail(c, v.tok, b"duplicate enum value ")
                mbig(c, next)
                madd(c, b" (`")
                madd(c, txt(c, v.tok))
                madd(c, b"` and `")
                madd(c, txt(c, nd(c, kid(c, en.extra, pj)).tok))
                madd(c, b"`)")
                (*c).cf = scf
                return error(e4)
            }
        }
        if mode == 1 && (next.neg || next.hi != 0 || next.huge || next.lo >= cast(u64, len)) {
            let name = txt(c, en.a)
            let vn = txt(c, v.tok)
            let vv = next
            (*c).cf = scf
            let e3 = fail3(c, pos, b"enum `", name, b"` does not fit `[")
            mdec(c, len)
            madd(c, b"]` (variant `")
            madd(c, vn)
            madd(c, b"` = ")
            mbig(c, vv)
            madd(c, b")")
            return error(e3)
        }
        next = big_add(next, big_u(1))
    }
    (*c).cf = scf
    return 0
}

// Klin's _checkEnumIndex.
fn check_enum_index(c: *mut Ck, ety: i32, obj: i32, pos: i32): !i32 {
    if kind(c, obj) != types.Tk.Array {
        return error(failt(c, pos, b"enum index requires a fixed array `[N]T`, got `", obj, b"`"))
    }
    return enum_values(c, tyof(c, ety).a, 1, tyof(c, obj).n, pos)
}
