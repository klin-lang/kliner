// elf.kl: the x86-64 executable. The data / globals references
// (rip-relative rel32) are resolved here; the ELF64 file itself is
// written by the shared back.image (src/back/elf.kl).
module x64
import back
import ir

// The executable image of a generated program (after gen).
pub fn image(c: *mut Cg): ![]u8 {
    let g = (*c).g
    let code = cast(i64, (*c).n)
    let dva = back.data_va(code)
    let bva = back.bss_va(code, cast(i64, (*g).nd))
    for i in 0..<(*c).nf {
        let x = (*c).fix[i]
        let from = back.code_va(cast(i64, x.pos) + 4)
        if x.kind == FX_DATA {
            put32(c, x.pos, dva + x.tgt - from)
        } else if x.kind == FX_BSS {
            put32(c, x.pos, bva + x.tgt - from)
        }
    }
    let syms = back.fn_syms((*c).a, (*g).fns, (*g).nfn + 1, (*c).fpos, (*c).fend, (*c).hpos, (*c).hend)!
    let img = back.image((*c).a, back.EM_X86_64, 0, (*c).b[0:(*c).n], (*g).data[0:(*g).nd], (*g).gsize, syms, syms.len) or {
        if err == back.E_BIG {
            madd(c, b"output too large")
            return error(E_X64)
        }
        return error(err)
    }
    return img
}
