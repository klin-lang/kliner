module main
import arena
import check
import diag
import ir
import sys
import x64
import lex
import load
import os
import out

// kliner-build: compiles a program to a static x86-64 Linux ELF executable
// (no libc, no linker) — stage 6 tool (docs/06-x86-64.md).
struct Ctx {
    a: arena.Arena
    o: out.Out
    e: out.Out
    p: load.Prog
}

fn report_load(c: *mut Ctx) {
    let p = &(*c).p
    let o = &(*c).e
    if (*p).kind == 1 {
        let f = load.file(p, (*p).err_file)
        diag.write_short(&(*f).d, o)
        return
    }
    if (*p).kind == 2 {
        let f = load.file(p, (*p).err_file)
        if (*p).err_tok < 0 {
            (*o).lit(b"1:1: ")
        } else {
            let [ln, col] = diag.pos(&(*f).d, (*f).lx.toks[(*p).err_tok].start)
            (*o).dec(cast(i64, ln))
            (*o).lit(b":")
            (*o).dec(cast(i64, col))
            (*o).lit(b": ")
        }
        (*o).lit(load.message(p))
        (*o).nl()
        return
    }
    (*o).lit(b"error: ")
    (*o).lit(load.message(p))
    (*o).lit(b": ")
    (*o).lit((*p).err_path)
    (*o).nl()
}

fn report_check(c: *mut Ctx, k: *mut check.Ck) {
    let o = &(*c).e
    let ef = check.err_file(k)
    let et = check.err_tok(k)
    if ef < 0 || et < 0 {
        (*o).lit(b"1:1: ")
    } else {
        let f = load.file(&(*c).p, ef)
        let [ln, col] = diag.pos(&(*f).d, (*f).lx.toks[et].start)
        (*o).dec(cast(i64, ln))
        (*o).lit(b":")
        (*o).dec(cast(i64, col))
        (*o).lit(b": ")
    }
    (*o).lit(check.message(k))
    (*o).nl()
}

fn report_ir(c: *mut Ctx, g: *mut ir.Prog) {
    let o = &(*c).e
    if (*g).ef < 0 || (*g).etok < 0 {
        (*o).lit(b"1:1: ")
    } else {
        let f = load.file(&(*c).p, (*g).ef)
        let [ln, col] = diag.pos(&(*f).d, (*f).lx.toks[(*g).etok].start)
        (*o).dec(cast(i64, ln))
        (*o).lit(b":")
        (*o).dec(cast(i64, col))
        (*o).lit(b": ")
    }
    (*o).lit(ir.message(g))
    (*o).nl()
}

fn usage(c: *mut Ctx): i32 {
    (*c).e.lit(b"usage: kliner-build [-I DIR]... FILE.kl -o OUT")
    (*c).e.nl()
    return 2
}

fn run(c: *mut Ctx): !i32 {
    let mut ok = 0
    (*c).a = arena.Arena.new(1 << 30)!
    let args = os.args(&(*c).a)!
    (*c).p = load.Prog.new(&(*c).a)!
    let mut entry = -1
    let mut outi = -1
    let mut i = 1
    while i < args.list.len {
        if lex.eq(args.list[i], b"-I") && i + 1 < args.list.len {
            ok = load.include(&(*c).p, args.list[i + 1])!
            i += 2
        } else if lex.eq(args.list[i], b"-o") && i + 1 < args.list.len {
            outi = i + 1
            i += 2
        } else if entry < 0 {
            entry = i
            i += 1
        } else {
            return usage(c)
        }
    }
    if entry < 0 || outi < 0 {
        return usage(c)
    }
    let m = load.run(&(*c).p, args.list[entry]) or {
        if err != load.E_LOAD {
            return error(err)
        }
        report_load(c)
        return 1
    }
    let mut k = check.Ck.new(&(*c).a, &(*c).p, true)!
    ok = check.run(&k) or {
        if err != check.E_CHECK {
            return error(err)
        }
        report_check(c, &k)
        return 1
    }
    let mut g = ir.Prog.new(&(*c).a, (*c).p.funcs.n, (*c).p.globals.n)!
    ok = ir.lower(&(*c).a, &k, &(*c).p, &g) or {
        if err != ir.E_IR {
            return error(err)
        }
        report_ir(c, &g)
        return 1
    }
    let mut cg = x64.Cg.new(&(*c).a, &g)!
    let mut img: []u8 = b""
    ok = x64.gen(&cg) or {
        if err != x64.E_X64 {
            return error(err)
        }
        (*c).e.lit(b"error: ")
        (*c).e.lit(x64.message(&cg))
        (*c).e.nl()
        return 1
    }
    img = x64.image(&cg) or {
        if err != x64.E_X64 {
            return error(err)
        }
        (*c).e.lit(b"error: ")
        (*c).e.lit(x64.message(&cg))
        (*c).e.nl()
        return 1
    }
    let fd = os.open_write(args.arg_z(outi))!
    ok = os.write_all(fd, img)!
    ok = os.close(fd)!
    return 0
}

fn main() {
    let mut c: Ctx
    c.e = out.Out.stderr()
    let code = run(&c) or {
        c.e.lit(b"kliner-build: error: ")
        c.e.errno_name(err)
        c.e.nl()
        2
    }
    c.e.flush_quiet()
    os.exit(code)
}
